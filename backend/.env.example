# ── Opção A: Supabase (nuvem — banco já criado e populado) ──────────────
# Copie a connection string em: Dashboard → Connect → ORM → Prisma
# (use o "Session pooler", que funciona em redes IPv4 comuns)
# DATABASE_URL="postgresql://postgres.[SEU-PROJETO]:[SUA-SENHA]@aws-1-[SUA-REGIAO].pooler.supabase.com:5432/postgres"

# ── Opção B: PostgreSQL local via Docker (docker-compose.yml) ───────────
DATABASE_URL="postgresql://portfoliolab:portfoliolab@localhost:5432/portfoliolab"

# Porta da API
PORT=3333

# Gere o seu com:  openssl rand -base64 32
# Deixado vazio de propósito: em NODE_ENV=production a API se recusa a subir
# com segredo vazio, curto (< 32) ou com um placeholder conhecido.
JWT_SECRET=""

# ── Módulo IA (Sprint 8) — análise de relatórios em PDF ─────────────────
# Crie sua chave em: https://aistudio.google.com/apikey
# Sem a chave, o restante do app funciona normalmente (só /reports retorna 503)
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-3.6-flash"
