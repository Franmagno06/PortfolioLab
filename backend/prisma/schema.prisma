generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Extensível: CRIPTO e INTERNACIONAL entram aqui no futuro sem quebrar nada
enum AssetType {
  ACAO
  FII
  ETF
  RENDA_FIXA
}

enum TransactionKind {
  COMPRA
  VENDA
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  transactions Transaction[]
  goals        AssetGoal[]
  dividends    Dividend[]
  reports      Report[]

  @@map("users")
}

model Asset {
  id           String    @id @default(uuid())
  ticker       String    @unique
  name         String
  type         AssetType
  // Opcional: o Yahoo Finance devolve setor para ações, mas quase nunca
  // para FII e ETF. Null significa "a fonte não informou", não "sem setor".
  sector       String?
  // Decimal, nunca Float: dinheiro exige precisão exata
  currentPrice Decimal   @map("current_price") @db.Decimal(12, 2)
  // Quando a cotação foi buscada pela última vez. Null = veio do seed e
  // nunca foi atualizada. Serve para decidir se vale consultar a API de novo.
  priceUpdatedAt DateTime? @map("price_updated_at")

  transactions Transaction[]
  goals        AssetGoal[]
  dividends    Dividend[]
  indicator    AssetIndicator?

  @@map("assets")
}

/// Indicadores fundamentalistas, cacheados a partir do Yahoo Finance
/// (quoteSummary: defaultKeyStatistics, financialData, assetProfile, price)
/// e do módulo Proventos (Dividend, para o Dividend Yield). Cache global por
/// ativo — não por usuário — porque o indicador é do ativo, não da carteira
/// de quem o possui. Atualizado por um job diário
/// (scripts/atualizar-indicadores.ts), nunca em tempo real na requisição.
model AssetIndicator {
  id      String  @id @default(uuid())
  assetId String  @unique @map("asset_id")
  /// Preço atual / (lucro líquido dos últimos 4 trimestres ÷ nº de ações).
  /// Calculado na mão a partir de netIncomeToCommon/sharesOutstanding — o
  /// campo trailingPE pronto do Yahoo mostrou-se pouco confiável para ações
  /// da B3 (ex.: TAEE11 vinha ~4x inflado). Pode ser negativo (empresa com
  /// prejuízo) ou extremo (lucro perto de zero) — isso é legítimo, não é
  /// filtrado.
  pl      Decimal? @db.Decimal(10, 2)
  /// Preço/Valor Patrimonial.
  pvp     Decimal? @db.Decimal(10, 2)
  /// Dividend Yield: soma dos proventos por cota pagos nos últimos 12 meses
  /// (módulo Proventos, não a fonte de cotação) dividida pelo preço atual,
  /// em pontos percentuais. Null se ninguém sincronizou proventos deste
  /// ativo ainda — não é erro, é ausência de dado importado.
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(7, 2)
  /// Retorno sobre patrimônio líquido, em pontos percentuais.
  roe     Decimal? @db.Decimal(7, 2)
  /// Retorno sobre ativos, em pontos percentuais. Padrão de mercado para
  /// bancos, que exibem isto no lugar da margem líquida (ver indicators.service.ts).
  roa     Decimal? @db.Decimal(7, 2)
  /// Margem líquida, em pontos percentuais.
  margemLiquida Decimal? @map("margem_liquida") @db.Decimal(7, 2)
  /// Setor/indústria como o Yahoo classifica (ex.: "Banks - Regional").
  /// Usado só para decidir se a tela mostra ROA no lugar de margem líquida.
  industria String? @db.Text
  /// Quando o job gravou estes valores pela última vez.
  updatedAt DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_indicators")
}

model Transaction {
  id         String          @id @default(uuid())
  // Ordem de cadastro. A data vem sem hora (o formulário é um <input type="date">),
  // então operações do mesmo dia empatam em executedAt e alguém precisa desempatar.
  // O uuid não serve: é aleatório, e ordenaria a venda antes da compra em metade
  // dos casos — o preço médio sairia errado por baixo de uma operação que a própria
  // API acabou de aprovar. seq é a única cronologia que sobra.
  seq        BigInt          @default(autoincrement())
  userId     String          @map("user_id")
  assetId    String          @map("asset_id")
  kind       TransactionKind
  // 18,8 comporta frações (útil para renda fixa hoje e cripto no futuro)
  quantity   Decimal         @db.Decimal(18, 8)
  unitPrice  Decimal         @map("unit_price") @db.Decimal(12, 2)
  fee        Decimal         @default(0) @db.Decimal(8, 2)
  executedAt DateTime        @map("executed_at")

  // Cascade: transação é dado DO usuário, não sobrevive a ele.
  // Restrict explícito no asset: é catálogo compartilhado — apagar um ativo
  // que alguém possui deve doer. Já era o padrão do Prisma; agora é intenção.
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([assetId])
  // as duas queries que alimentam calcularPosicao ordenam exatamente assim
  @@index([userId, assetId, executedAt, seq])
  @@map("transactions")
}

model AssetGoal {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  assetId      String  @map("asset_id")
  // Percentual alvo do ativo na carteira, ex: 12.50
  targetWeight Decimal @map("target_weight") @db.Decimal(5, 2)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // Um usuário só pode ter UMA meta por ativo
  @@unique([userId, assetId])
  @@map("asset_goals")
}

// Relatório gerencial analisado pela IA (Sprint 8)
model Report {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fileName      String   @map("file_name")
  // texto extraído do PDF — usado pelo chat "Pergunte ao Relatório"
  extractedText String   @map("extracted_text") @db.Text
  // resultado da análise (resumo, alertas, indicadores) como JSON
  analysis      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reports")
}

/// De onde veio o provento. MANUAL é o que o usuário lançou à mão; PROVEDOR é
/// o que a sincronização importou do Yahoo Finance e recalculou pela posição.
enum DividendSource {
  MANUAL
  PROVEDOR
}

model Dividend {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  assetId String   @map("asset_id")
  amount  Decimal  @db.Decimal(12, 2)
  /// Valor por cota anunciado pela empresa. Só o PROVEDOR preenche: no lançamento
  /// manual o usuário informa o total recebido, não a taxa por cota.
  unitAmount Decimal? @map("unit_amount") @db.Decimal(12, 6)
  /// Para MANUAL, a data que o usuário informou. Para PROVEDOR, a data-ex do
  /// Yahoo — quem tinha a posição antes dela recebe. Não é a data de pagamento,
  /// que a fonte não fornece.
  paidAt  DateTime @map("paid_at")
  source  DividendSource @default(MANUAL)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId])
  /// Torna a sincronização idempotente: rodar de novo atualiza a linha em vez
  /// de duplicar o provento. Não atrapalha o manual, que fica noutra origem.
  @@unique([userId, assetId, paidAt, source])
  @@map("dividends")
}
