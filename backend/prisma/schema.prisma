generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Extensível: CRIPTO e INTERNACIONAL entram aqui no futuro sem quebrar nada
enum AssetType {
  ACAO
  FII
  ETF
  RENDA_FIXA
}

enum TransactionKind {
  COMPRA
  VENDA
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  transactions Transaction[]
  goals        AssetGoal[]
  dividends    Dividend[]
  reports      Report[]

  @@map("users")
}

model Asset {
  id           String    @id @default(uuid())
  ticker       String    @unique
  name         String
  type         AssetType
  sector       String?
  // Decimal, nunca Float: dinheiro exige precisão exata
  currentPrice Decimal   @map("current_price") @db.Decimal(12, 2)
  // Quando a cotação foi buscada pela última vez. Null = veio do seed e
  // nunca foi atualizada. Serve para decidir se vale consultar a API de novo.
  priceUpdatedAt DateTime? @map("price_updated_at")

  transactions Transaction[]
  goals        AssetGoal[]
  dividends    Dividend[]

  @@map("assets")
}

model Transaction {
  id         String          @id @default(uuid())
  // Ordem de cadastro. A data vem sem hora (o formulário é um <input type="date">),
  // então operações do mesmo dia empatam em executedAt e alguém precisa desempatar.
  // O uuid não serve: é aleatório, e ordenaria a venda antes da compra em metade
  // dos casos — o preço médio sairia errado por baixo de uma operação que a própria
  // API acabou de aprovar. seq é a única cronologia que sobra.
  seq        BigInt          @default(autoincrement())
  userId     String          @map("user_id")
  assetId    String          @map("asset_id")
  kind       TransactionKind
  // 18,8 comporta frações (útil para renda fixa hoje e cripto no futuro)
  quantity   Decimal         @db.Decimal(18, 8)
  unitPrice  Decimal         @map("unit_price") @db.Decimal(12, 2)
  fee        Decimal         @default(0) @db.Decimal(8, 2)
  executedAt DateTime        @map("executed_at")

  // Cascade: transação é dado DO usuário, não sobrevive a ele.
  // Restrict explícito no asset: é catálogo compartilhado — apagar um ativo
  // que alguém possui deve doer. Já era o padrão do Prisma; agora é intenção.
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([assetId])
  // as duas queries que alimentam calcularPosicao ordenam exatamente assim
  @@index([userId, assetId, executedAt, seq])
  @@map("transactions")
}

model AssetGoal {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  assetId      String  @map("asset_id")
  // Percentual alvo do ativo na carteira, ex: 12.50
  targetWeight Decimal @map("target_weight") @db.Decimal(5, 2)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // Um usuário só pode ter UMA meta por ativo
  @@unique([userId, assetId])
  @@map("asset_goals")
}

// Relatório gerencial analisado pela IA (Sprint 8)
model Report {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fileName      String   @map("file_name")
  // texto extraído do PDF — usado pelo chat "Pergunte ao Relatório"
  extractedText String   @map("extracted_text") @db.Text
  // resultado da análise (resumo, alertas, indicadores) como JSON
  analysis      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reports")
}

model Dividend {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  assetId String   @map("asset_id")
  amount  Decimal  @db.Decimal(12, 2)
  paidAt  DateTime @map("paid_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("dividends")
}
